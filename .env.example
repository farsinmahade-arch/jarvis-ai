# OpenAI API Key (required for AI chat)
OPENAI_API_KEY=your-openai-api-key-here

# SearchAPI Key (optional, for web search)
SEARCHAPI_KEY=your-searchapi-key-here

# Deepgram API Key (optional, for speech-to-text)
DEEPGRAM_API_KEY=your-deepgram-key-here

# ElevenLabs API Key (optional, for text-to-speech)
ELEVENLABS_API_KEY=your-elevenlabs-key-here

# Porcupine Access Key (optional, for wake word detection)
PORCUPINE_ACCESS_KEY=your-porcupine-key-here

# Server Port
PORT=3001
