{
  "name": "jarvis-ai",
  "version": "2.0.0",
  "description": "JARVIS — AI-Powered Desktop Assistant",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "node backend/server.js",
    "dev:frontend": "cd frontend && npm run dev",
    "build": "cd frontend && npm run build",
    "start": "electron .",
    "electron:dev": "NODE_ENV=development concurrently \"npm run dev:backend\" \"npm run dev:frontend\" \"sleep 3 && electron .\""
  },
  "keywords": [
    "jarvis",
    "ai",
    "assistant",
    "electron",
    "desktop"
  ],
  "author": "Farsin",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^9.2.1",
    "electron": "^42.2.0"
  },
  "dependencies": {
    "axios": "^1.16.1",
    "better-sqlite3": "^12.10.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "openai": "^6.39.0",
    "uuid": "^14.0.0"
  }
}
